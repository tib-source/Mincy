{
	"name": "mincy-agent",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch index.ts",
		"start": "bun index.ts",
		"build": "bun build index.ts --outdir ./dist --target bun --external cpu-features",
		"build:production": "bun build index.ts --outdir ./dist --target bun --external cpu-features --minify",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"lint:ci": "biome ci .",
		"format": "biome format .",
		"format:fix": "biome format --fix .",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@mincy/shared": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.0.0"
	}
}
