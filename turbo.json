{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env"],
	"tasks": {
		"generate:manifests": {
			"inputs": ["nodes/*/manifest.json"],
			"outputs": ["client/src/generated/node-manifests.json"],
			"cache": true
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["generate:manifests"],
			"outputs": []
		},
		"build": {
			"inputs": ["src/**", "package.json"],
			"dependsOn": ["^build", "generate:manifests"],
			"outputs": ["dist/**", ".next/**"],
			"env": [
				"NEXT_PUBLIC_SUPABASE_URL",
				"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
				"SUPABASE_PRIVATE_KEY",
				"GITHUB_APP_ID",
				"GITHUB_WEBHOOK_SECRET",
				"GITHUB_APP_PRIVATE_KEY",
				"NEXT_PUBLIC_GITHUB_APP_SLUG"
			]
		},
		"lint": {
			"cache": false
		},
		"lint:fix": {
			"cache": false
		},
		"lint:ci": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"format:fix": {
			"cache": false
		},
		"test": {}
	}
}
