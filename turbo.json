{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env"],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": [],
			"outputs": []
		},
		"build": {
			"inputs": ["src/**", "package.json"],
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**"]
		},
		"lint": {
			"cache": false,
			"persistent": true,
			"dependsOn": [],
			"outputs": []
		},
		"test": {}
	}
}
